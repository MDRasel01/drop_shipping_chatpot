# AI Customer Support SaaS - Environment Configuration

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL (pgvector enabled)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/customer_support_saas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=customer_support_saas
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# JWT & Inter-Service Security
SECRET_KEY=super-secret-jwt-key-customer-support-saas-minimum-32-chars-long!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
INTER_SERVICE_SECRET=dev-cluster-inter-service-secret-key-32bytes-min!

# Email Provider
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@saas-platform.com
SMTP_FROM_NAME="AI Support Platform"

